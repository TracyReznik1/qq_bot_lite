# Flask 服务
BOT_HOST=127.0.0.1
BOT_PORT=5000
CALLBACK_SECRET=

# OneBot 连接
ONEBOT_API_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=
REQUIRE_GROUP_AT=true

# 对话模型链：第一个是主模型，后续按顺序回退。
# 格式：提供商:模型名，支持 gemini 和 deepseek。
CHAT_MODELS=gemini:gemini-3.1-flash-lite
# 记忆提取专用模型链（可选）：留空时自动复用 CHAT_MODELS。
# 推荐配置轻量高并发模型（如 gemini:gemini-2.0-flash-lite 或 deepseek:deepseek-chat），与对话模型限额隔离。
MEMORY_MODELS=

# Gemini 原生 generateContent API
GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com/v1

# DeepSeek OpenAI 兼容 API
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# 搜索与网络
# Tavily 是主搜索提供者；未解决、失败或无结果的查询使用 DDGS 回退。
# 两者都失败时不得伪造在线证据。
TAVILY_API_KEY=
PROXY_URL=
# SEARCH_MAX_RESULTS 是每个搜索查询的 provider 结果上限（至少为 1）。
SEARCH_MAX_RESULTS=4
SEARCH_PLANNER_TIMEOUT=8.0
SEARCH_TAVILY_TIMEOUT=8.0
SEARCH_DDGS_TIMEOUT=15.0
SEARCH_READER_TIMEOUT=5.0
SEARCH_RANKER_TIMEOUT=10.0
SEARCH_ANSWER_TIMEOUT=20.0
REQUEST_TIMEOUT=18.0

# 数据、历史与记忆
DATA_DIR=qqbot_data
HISTORY_TURNS=8
PERSIST_HISTORY=true

# 消息处理与回复
MESSAGE_WORKERS=8
MAX_REPLY_CHARS=1700

# 管理员 QQ 号，多个值用英文逗号或分号分隔
ADMIN_QQ_IDS=
