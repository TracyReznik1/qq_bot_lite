# Flask 服务
BOT_HOST=127.0.0.1
BOT_PORT=5000
CALLBACK_SECRET=

# OneBot 连接
ONEBOT_API_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=
REQUIRE_GROUP_AT=true

# 对话模型链：第一个是主模型，后续按顺序回退。
# 格式：提供商:模型名，支持 gemini 和 deepseek。
CHAT_MODELS=gemini:gemini-3.1-flash-lite
# 可选：留空时，记忆提取复用 CHAT_MODELS；可填写 gemini:gemini-3.1-flash-lite。
MEMORY_MODELS=

# Gemini 原生 generateContent API
GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com/v1

# DeepSeek OpenAI 兼容 API
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# 搜索与网络
# TAVILY_API_KEY 为主搜索提供者密钥。未配置且 DDGS 也不可用时，事实型请求返回 provider_not_configured；
# 已配置但不可用（如无依赖）时返回 provider_unavailable。两者都不会静默按普通聊天处理。
TAVILY_API_KEY=
PROXY_URL=
# SEARCH_MAX_RESULTS 是每个搜索查询的 provider 结果上限（至少为 1），不能提高 tier 的候选 URL/正文读取上限。
SEARCH_MAX_RESULTS=4
REQUEST_TIMEOUT=18.0

# 数据、历史与记忆
DATA_DIR=qqbot_data
HISTORY_TURNS=8
PERSIST_HISTORY=true

# 消息处理与回复
MESSAGE_WORKERS=8
MAX_REPLY_CHARS=1700

# 管理员 QQ 号，多个值用英文逗号或分号分隔
ADMIN_QQ_IDS=
